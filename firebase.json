{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/uploadVideo",
        "function": "uploadVideo"
      },
      {
        "source": "/tv",
        "destination": "/display.html"
      },
      {
        "source": "/tv/**",
        "destination": "/display.html"
      },
      {
        "source": "/display",
        "destination": "/display.html"
      },
      {
        "source": "/display/**",
        "destination": "/display.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  }
}
